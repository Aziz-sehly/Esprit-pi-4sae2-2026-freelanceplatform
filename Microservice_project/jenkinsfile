pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    environment {
        DOCKERHUB_USER  = 'azizsehli'
        DOCKERHUB_CREDS = 'dockerhub'
        K8S_NAMESPACE   = 'pidev'
        IMAGE_TAG       = "${env.BUILD_NUMBER}"
        SERVICE_TAG     = 'microservice-project'
        SONAR_KEY       = 'project-service'
        K8S_DEPLOYMENT  = 'project-service'   // plus utilisé, vous pouvez le supprimer si vous voulez
    }

    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Maven Build') {
            steps {
                dir('Microservice_project') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir('Microservice_project') {
                    sh 'mvn test'
                }
            }
            post {
                always {
                    junit '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    dir('Microservice_project') {
                        sh """
                            mvn sonar:sonar \
                              -Dsonar.projectKey=pidev-${SONAR_KEY} \
                              -Dsonar.projectName=pidev-${SONAR_KEY}
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', DOCKERHUB_CREDS) {
                        def image = docker.build(
                            "${DOCKERHUB_USER}/${SERVICE_TAG}:${IMAGE_TAG}",
                            "."
                        )
                        image.push()
                    }
                }
            }
        }
    }

    post {
        always { cleanWs() }
        success { echo "✅ PIPELINE RÉUSSI!" }
        failure { echo "❌ PIPELINE ÉCHOUÉ - Vérifiez les logs" }
    }
}