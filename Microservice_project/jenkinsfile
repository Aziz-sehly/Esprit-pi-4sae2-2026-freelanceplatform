pipeline {
    agent any

    options {
        skipDefaultCheckout(true)   // 🔥 important pour accélérer SCM
        timestamps()
    }

    environment {
        DOCKERHUB_USER  = 'azizsehly'
        DOCKERHUB_CREDS = 'dockerhub-credentials'
        K8S_NAMESPACE   = 'pidev'
        IMAGE_TAG       = "${env.BUILD_NUMBER}"pipeline {
                                                   agent any

                                                   options {
                                                       skipDefaultCheckout(true)   // 🔥 important pour accélérer SCM
                                                       timestamps()
                                                   }

                                                   environment {
                                                       DOCKERHUB_USER  = 'azizsehly'
                                                       DOCKERHUB_CREDS = 'dockerhub-credentials'
                                                       K8S_NAMESPACE   = 'pidev'
                                                       IMAGE_TAG       = "${env.BUILD_NUMBER}"

                                                       SERVICE_FOLDER  = 'Microservice_project'
                                                       SERVICE_TAG     = 'microservice-project'
                                                       SONAR_KEY       = 'project-service'
                                                       K8S_DEPLOYMENT  = 'project-service'
                                                   }

                                                   stages {

                                                       stage('Checkout (FAST)') {
                                                           steps {
                                                               checkout scm
                                                           }
                                                       }

                                                       stage('Maven Build (FAST)') {
                                                           steps {
                                                               dir("${SERVICE_FOLDER}") {
                                                                   sh 'mvn -T 2C clean package -DskipTests'
                                                               }
                                                           }
                                                       }

                                                       stage('SonarQube') {
                                                           steps {
                                                               withSonarQubeEnv('SonarQube') {
                                                                   dir("${SERVICE_FOLDER}") {
                                                                       sh """
                                                                           mvn sonar:sonar \
                                                                             -Dsonar.projectKey=pidev-${SONAR_KEY} \
                                                                             -Dsonar.projectName=pidev-${SONAR_KEY}
                                                                       """
                                                                   }
                                                               }
                                                           }
                                                       }

                                                       stage('Quality Gate') {
                                                           steps {
                                                               timeout(time: 5, unit: 'MINUTES') {
                                                                   waitForQualityGate abortPipeline: true
                                                               }
                                                           }
                                                       }

                                                       stage('Docker Build (FAST)') {
                                                           steps {
                                                               script {
                                                                   docker.withRegistry('https://index.docker.io/v1/', DOCKERHUB_CREDS) {

                                                                       def image = docker.build(
                                                                           "${DOCKERHUB_USER}/${SERVICE_TAG}:${IMAGE_TAG}",
                                                                           "${SERVICE_FOLDER}"   // 🔥 plus propre
                                                                       )

                                                                       image.push()
                                                                   }
                                                               }
                                                           }
                                                       }

                                                       stage('Deploy') {
                                                           steps {
                                                               withKubeConfig([credentialsId: 'kubeconfig-credentials']) {
                                                                   sh """
                                                                       kubectl set image deployment/${K8S_DEPLOYMENT} \
                                                                         ${K8S_DEPLOYMENT}=${DOCKERHUB_USER}/${SERVICE_TAG}:${IMAGE_TAG} \
                                                                         -n ${K8S_NAMESPACE}

                                                                       kubectl rollout status deployment/${K8S_DEPLOYMENT} \
                                                                         -n ${K8S_NAMESPACE} --timeout=120s
                                                                   """
                                                               }
                                                           }
                                                       }
                                                   }

                                                   post {
                                                       always {
                                                           cleanWs()
                                                       }
                                                   }
                                               }

        SERVICE_FOLDER  = 'Microservice_project'
        SERVICE_TAG     = 'microservice-project'
        SONAR_KEY       = 'project-service'
        K8S_DEPLOYMENT  = 'project-service'
    }

    stages {

        stage('Checkout (FAST)') {
            steps {
                checkout scm
            }
        }

        stage('Maven Build (FAST)') {
            steps {
                dir("${SERVICE_FOLDER}") {
                    sh 'mvn -T 2C clean package -DskipTests'
                }
            }
        }

        stage('SonarQube') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    dir("${SERVICE_FOLDER}") {
                        sh """
                            mvn sonar:sonar \
                              -Dsonar.projectKey=pidev-${SONAR_KEY} \
                              -Dsonar.projectName=pidev-${SONAR_KEY}
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build (FAST)') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', DOCKERHUB_CREDS) {

                        def image = docker.build(
                            "${DOCKERHUB_USER}/${SERVICE_TAG}:${IMAGE_TAG}",
                            "${SERVICE_FOLDER}"   // 🔥 plus propre
                        )

                        image.push()
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                withKubeConfig([credentialsId: 'kubeconfig-credentials']) {
                    sh """
                        kubectl set image deployment/${K8S_DEPLOYMENT} \
                          ${K8S_DEPLOYMENT}=${DOCKERHUB_USER}/${SERVICE_TAG}:${IMAGE_TAG} \
                          -n ${K8S_NAMESPACE}

                        kubectl rollout status deployment/${K8S_DEPLOYMENT} \
                          -n ${K8S_NAMESPACE} --timeout=120s
                    """
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}