pipeline {
    // ------------------------------------------------------------
    // 1. Agent Docker avec Maven + JDK 17 (plus besoin de tools)
    // ------------------------------------------------------------
    agent {
        docker {
            image 'maven:3.9.6-eclipse-temurin-17'
            args '-v /var/run/docker.sock:/var/run/docker.sock -v maven-repo:/root/.m2'
        }
    }

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    environment {
        DOCKERHUB_USER  = 'azizsehli'
        DOCKERHUB_CREDS = 'dockerhub-credentials'
        K8S_NAMESPACE   = 'pidev'
        IMAGE_TAG       = "${env.BUILD_NUMBER}"
        SERVICE_FOLDER  = 'Microservice_project'
        SERVICE_TAG     = 'microservice-project'
        SONAR_KEY       = 'project-service'
        K8S_DEPLOYMENT  = 'project-service'

        // Optimisation Maven : utilise le cache persistant et saute les tests définitivement
        MAVEN_OPTS      = '-Dmaven.repo.local=/root/.m2/repository'
    }

    stages {

        // --------------------------------------------------------
        // Étape 1 : Checkout (rapide)
        // --------------------------------------------------------
        stage('Checkout (FAST)') {
            steps {
                checkout scm
            }
        }

        // --------------------------------------------------------
        // Étape 2 : Maven Build (avec cache et sans tests)
        // --------------------------------------------------------
        stage('Maven Build (FAST)') {
            steps {
                dir("${SERVICE_FOLDER}") {
                    // On évite "clean" pour garder le cache des classes compilées
                    // On utilise -T 2C pour parallélisation
                    // On skip les tests (compilation + exécution)
                    sh 'mvn -T 2C package -Dmaven.test.skip=true'
                }
            }
        }

        // --------------------------------------------------------
        // Étape 3 : SonarQube
        // --------------------------------------------------------
        stage('SonarQube') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    dir("${SERVICE_FOLDER}") {
                        sh """
                            mvn sonar:sonar \
                              -Dsonar.projectKey=pidev-${SONAR_KEY} \
                              -Dsonar.projectName=pidev-${SONAR_KEY}
                        """
                    }
                }
            }
        }

        // --------------------------------------------------------
        // Étape 4 : Quality Gate
        // --------------------------------------------------------
        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // --------------------------------------------------------
        // Étape 5 : Docker Build & Push
        // --------------------------------------------------------
        stage('Docker Build & Push') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', DOCKERHUB_CREDS) {
                        def image = docker.build(
                            "${DOCKERHUB_USER}/${SERVICE_TAG}:${IMAGE_TAG}",
                            "${SERVICE_FOLDER}"
                        )
                        image.push()
                    }
                }
            }
        }

        // --------------------------------------------------------
        // Étape 6 : Deploy to Kubernetes
        // --------------------------------------------------------
        stage('Deploy to Kubernetes') {
            steps {
                withKubeConfig([credentialsId: 'kubeconfig-credentials']) {
                    sh """
                        kubectl set image deployment/${K8S_DEPLOYMENT} \
                          ${K8S_DEPLOYMENT}=${DOCKERHUB_USER}/${SERVICE_TAG}:${IMAGE_TAG} \
                          -n ${K8S_NAMESPACE}
                        kubectl rollout status deployment/${K8S_DEPLOYMENT} \
                          -n ${K8S_NAMESPACE} --timeout=120s
                    """
                }
            }
        }
    }

    // --------------------------------------------------------
    // Nettoyage obligatoire (gardé)
    // --------------------------------------------------------
    post {
        always {
            cleanWs()
        }
        success {
            echo "✅ PIPELINE RÉUSSI - Build accéléré !"
        }
        failure {
            echo "❌ PIPELINE ÉCHOUÉ - Vérifiez les logs"
        }
    }
}