pipeline {
    agent {
        docker {
            image 'docker:latest'   // besoin de Docker seulement
            args '-v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        DOCKERHUB_USER  = 'azizsehli'
        DOCKERHUB_CREDS = 'dockerhub-credentials'
        K8S_NAMESPACE   = 'pidev'
        IMAGE_TAG       = "${env.BUILD_NUMBER}"
        SERVICE_FOLDER  = 'Microservice_project'
        SERVICE_TAG     = 'microservice-project'
        K8S_DEPLOYMENT  = 'project-service'
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', DOCKERHUB_CREDS) {
                        def image = docker.build(
                            "${DOCKERHUB_USER}/${SERVICE_TAG}:${IMAGE_TAG}",
                            "${SERVICE_FOLDER}"   // contexte = dossier avec Dockerfile
                        )
                        image.push()
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                withKubeConfig([credentialsId: 'kubeconfig-credentials']) {
                    sh """
                        kubectl set image deployment/${K8S_DEPLOYMENT} \
                          ${K8S_DEPLOYMENT}=${DOCKERHUB_USER}/${SERVICE_TAG}:${IMAGE_TAG} \
                          -n ${K8S_NAMESPACE}
                        kubectl rollout status deployment/${K8S_DEPLOYMENT} -n ${K8S_NAMESPACE}
                    """
                }
            }
        }
    }

    post {
        always { cleanWs() }
        success { echo "✅ Succès" }
        failure { echo "❌ Échec" }
    }
}