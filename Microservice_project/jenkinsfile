pipeline {
    // ==========================================
    // 1. AGENT DOCKER MAVEN (CORRECTION MAGIQUE)
    // ==========================================
    agent any {
        docker {
            image 'maven:3.9.6-eclipse-temurin-17'
            // Montage du cache Maven ($HOME/.m2) et du socket Docker pour la construction
            args '-v $HOME/.m2:/root/.m2 -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    environment {
        DOCKERHUB_USER  = 'azizsehly'
        DOCKERHUB_CREDS = 'dockerhub-credentials'
        K8S_NAMESPACE   = 'pidev'
        IMAGE_TAG       = "${env.BUILD_NUMBER}"
        SERVICE_FOLDER  = 'Microservice_project'
        SERVICE_TAG     = 'microservice-project'
        SONAR_KEY       = 'project-service'
        K8S_DEPLOYMENT  = 'project-service'
    }

    stages {
        stage('Checkout (FAST)') {
            steps {
                checkout scm
            }
        }

        stage('Maven Build (FAST)') {
            steps {
                dir("${SERVICE_FOLDER}") {
                    // Avec le cache Maven monté, plus besoin de re-télécharger les dépendances à chaque fois
                    sh 'mvn -T 2C clean package -DskipTests'
                }
            }
        }

        stage('SonarQube') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    dir("${SERVICE_FOLDER}") {
                        sh """
                            mvn sonar:sonar \
                              -Dsonar.projectKey=pidev-${SONAR_KEY} \
                              -Dsonar.projectName=pidev-${SONAR_KEY}
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', DOCKERHUB_CREDS) {
                        def image = docker.build(
                            "${DOCKERHUB_USER}/${SERVICE_TAG}:${IMAGE_TAG}",
                            "${SERVICE_FOLDER}"
                        )
                        image.push()
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withKubeConfig([credentialsId: 'kubeconfig-credentials']) {
                    sh """
                        kubectl set image deployment/${K8S_DEPLOYMENT} \
                          ${K8S_DEPLOYMENT}=${DOCKERHUB_USER}/${SERVICE_TAG}:${IMAGE_TAG} \
                          -n ${K8S_NAMESPACE}
                        kubectl rollout status deployment/${K8S_DEPLOYMENT} \
                          -n ${K8S_NAMESPACE} --timeout=120s
                    """
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "✅ PIPELINE RÉUSSI - Build accéléré !"
        }
        failure {
            echo "❌ PIPELINE ÉCHOUÉ - Vérifiez les logs"
        }
    }
}