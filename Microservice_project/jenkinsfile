pipeline {
    agent any  // ✅ FIXED - just this, no docker block

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    environment {
        DOCKERHUB_USER  = 'azizsehly'
        DOCKERHUB_CREDS = 'dockerhub-credentials'
        K8S_NAMESPACE   = 'pidev'
        IMAGE_TAG       = "${env.BUILD_NUMBER}"
        SERVICE_FOLDER  = 'Microservice_project'
        SERVICE_TAG     = 'microservice-project'
        SONAR_KEY       = 'project-service'
        K8S_DEPLOYMENT  = 'project-service'
    }

    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Maven Build') {
            steps {
                dir("${SERVICE_FOLDER}") {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir("${SERVICE_FOLDER}") {
                    sh 'mvn test'
                }
            }
            post {
                always {
                    junit '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    dir("${SERVICE_FOLDER}") {
                        sh """
                            mvn sonar:sonar \
                              -Dsonar.projectKey=pidev-${SONAR_KEY} \
                              -Dsonar.projectName=pidev-${SONAR_KEY}
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', DOCKERHUB_CREDS) {
                        def image = docker.build(
                            "${DOCKERHUB_USER}/${SERVICE_TAG}:${IMAGE_TAG}",
                            "${SERVICE_FOLDER}"
                        )
                        image.push()
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withKubeConfig([credentialsId: 'kubeconfig-credentials']) {
                    sh """
                        kubectl set image deployment/${K8S_DEPLOYMENT} \
                          ${K8S_DEPLOYMENT}=${DOCKERHUB_USER}/${SERVICE_TAG}:${IMAGE_TAG} \
                          -n ${K8S_NAMESPACE}
                        kubectl rollout status deployment/${K8S_DEPLOYMENT} \
                          -n ${K8S_NAMESPACE} --timeout=120s
                    """
                }
            }
        }
    }

    post {
        always { cleanWs() }
        success { echo "✅ PIPELINE RÉUSSI!" }
        failure { echo "❌ PIPELINE ÉCHOUÉ - Vérifiez les logs" }
    }
}