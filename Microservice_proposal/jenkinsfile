pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    environment {
        DOCKERHUB_USER  = 'azizsehli'
        DOCKERHUB_CREDS = 'dockerhub'
        IMAGE_TAG       = "${env.BUILD_NUMBER}"
        SERVICE_FOLDER  = 'Microservice_proposal'
        SERVICE_TAG     = 'microservice-proposal'
        SONAR_KEY       = 'proposal-service'
    }

    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Maven Build') {
            steps {
                dir("${SERVICE_FOLDER}") {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir("${SERVICE_FOLDER}") {
                    sh 'mvn test'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    dir("${SERVICE_FOLDER}") {
                        sh """
                            mvn sonar:sonar \
                              -Dsonar.projectKey=pidev-${SONAR_KEY} \
                              -Dsonar.projectName=pidev-${SONAR_KEY}
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build & Push') {
                   steps {
                       script {
                           docker.withRegistry('https://index.docker.io/v1/', DOCKERHUB_CREDS) {
                               def image = docker.build(
                                   "${DOCKERHUB_USER}/${SERVICE_TAG}:${IMAGE_TAG}",
                                    "Microservice_proposal"
                               )
                               image.push()
                           }
                       }
                   }
               }
    }

    post {
        always { cleanWs() }
        success { echo "✅ PIPELINE PROPOSAL RÉUSSI!" }
        failure { echo "❌ PIPELINE PROPOSAL ÉCHOUÉ - Vérifiez les logs" }
    }
}