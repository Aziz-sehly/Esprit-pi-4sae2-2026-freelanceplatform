pipeline {
    agent any

    environment {
        DOCKERHUB_USER  = 'azizsehli'
        DOCKERHUB_CREDS = 'dockerhub-credentials'
        K8S_NAMESPACE   = 'pidev'
        IMAGE_TAG       = "${env.BUILD_NUMBER}"

        SERVICE_FOLDER  = 'Microservice_proposal'
        SERVICE_TAG     = 'Microservice_proposal'
        SONAR_KEY       = 'proposal-service'
        K8S_DEPLOYMENT  = 'proposal-service'
    }

    stages {

        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Maven Build') {
            steps {
                dir("${SERVICE_FOLDER}") {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    dir("${SERVICE_FOLDER}") {
                        sh """
                            mvn sonar:sonar \
                              -Dsonar.projectKey=pidev-${SONAR_KEY} \
                              -Dsonar.projectName=pidev-${SONAR_KEY} \
                              -Dsonar.host.url=${env.SONAR_HOST_URL} \
                              -Dsonar.login=${env.SONAR_AUTH_TOKEN}
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build & Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', DOCKERHUB_CREDS) {
                        def image = docker.build(
                            "${DOCKERHUB_USER}/pidev_microservices:${SERVICE_TAG}",
                            "./${SERVICE_FOLDER}"
                        )
                        image.push()
                        image.push("${SERVICE_TAG}-${IMAGE_TAG}")
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withKubeConfig([credentialsId: 'kubeconfig-credentials']) {
                    sh """
                        kubectl set image deployment/${K8S_DEPLOYMENT} \
                          ${K8S_DEPLOYMENT}=${DOCKERHUB_USER}/pidev_microservices:${SERVICE_TAG} \
                          -n ${K8S_NAMESPACE}
                        kubectl rollout status deployment/${K8S_DEPLOYMENT} \
                          -n ${K8S_NAMESPACE} --timeout=120s
                    """
                }
            }
        }

        stage('Verify') {
            steps {
                withKubeConfig([credentialsId: 'kubeconfig-credentials']) {
                    sh "kubectl get pods -l app=${K8S_DEPLOYMENT} -n ${K8S_NAMESPACE}"
                }
            }
        }
    }

    post {
        success { echo "✅ ${SERVICE_TAG} — Build #${env.BUILD_NUMBER} deployed." }
        failure { echo "❌ ${SERVICE_TAG} — Build #${env.BUILD_NUMBER} failed." }
        always  { cleanWs() }
    }
}