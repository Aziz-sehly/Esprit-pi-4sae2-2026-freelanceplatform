// =====================================================================
//  media-analysis-service · CI/CD pipeline
// =====================================================================
pipeline {
  agent any

  options {
    timestamps()
    ansiColor('xterm')
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 30, unit: 'MINUTES')
  }

  triggers {
    githubPush()
  }

  tools {
    maven 'Maven-3.9'
    jdk   'JDK-17'
  }

  environment {
    SERVICE_NAME    = 'media-analysis-service'
    IMAGE_NAME      = "${env.DOCKERHUB_NAMESPACE ?: 'prolance'}/media-analysis-service"
    IMAGE_TAG       = "${env.BUILD_NUMBER}"
    SONAR_PROJECT   = 'prolance-media-analysis-service'
    K8S_NAMESPACE   = 'prolance'
    KUBECONFIG_CRED = 'kubeconfig-prolance'
    DOCKERHUB_CRED  = 'dockerhub-creds'
    SONAR_TOKEN     = credentials('sonarqube-token')
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
        sh 'echo "Building $SERVICE_NAME @ $(git rev-parse --short HEAD)"'
      }
    }

    stage('Build') {
      steps {
        dir('backend/media-analysis-service') {
          sh 'mvn -B -ntp -DskipTests clean package'
        }
      }
    }

    stage('Test') {
      steps {
        dir('backend/media-analysis-service') {
          sh 'mvn -B -ntp test verify'
        }
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: 'backend/media-analysis-service/target/surefire-reports/*.xml'
          archiveArtifacts artifacts: 'backend/media-analysis-service/target/site/jacoco/jacoco.xml', allowEmptyArchive: true
        }
      }
    }

    stage('SonarQube Analysis') {
      steps {
        dir('backend/media-analysis-service') {
          withSonarQubeEnv('SonarQube') {
            sh '''
              mvn -B -ntp sonar:sonar \
                -Dsonar.projectKey=$SONAR_PROJECT \
                -Dsonar.host.url=$SONAR_HOST_URL \
                -Dsonar.login=$SONAR_TOKEN
            '''
          }
        }
      }
    }

    stage('Quality Gate') {
      steps {
        timeout(time: 5, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: false
        }
      }
    }

    stage('Docker · build & push') {
      steps {
        dir('backend/media-analysis-service') {
          script {
            docker.withRegistry('https://index.docker.io/v1/', "${DOCKERHUB_CRED}") {
              def img = docker.build("${IMAGE_NAME}:${IMAGE_TAG}", '.')
              img.push()
              img.push('latest')
            }
          }
        }
      }
    }

    stage('Deploy → KubeAdm cluster') {
      when { anyOf { branch 'main'; branch 'sadok-devops' } }
      steps {
        withCredentials([file(credentialsId: "${KUBECONFIG_CRED}", variable: 'KUBECONFIG')]) {
          sh '''
            kubectl -n ${K8S_NAMESPACE} apply -f backend/media-analysis-service/k8s/
            kubectl -n ${K8S_NAMESPACE} set image deployment/media-analysis-service \
              media-analysis-service=${IMAGE_NAME}:${IMAGE_TAG} --record
            kubectl -n ${K8S_NAMESPACE} rollout status deployment/media-analysis-service --timeout=180s
          '''
        }
      }
    }
  }

  post {
    success { echo "✔ ${SERVICE_NAME} pipeline OK · image ${IMAGE_NAME}:${IMAGE_TAG}" }
    failure { echo "✖ ${SERVICE_NAME} pipeline FAILED" }
    always  { cleanWs() }
  }
}
